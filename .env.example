# 复制成 .env 再改（docker compose 会自动读取）

# 查询接口的 token：调用方要带 ?token=... 或 X-Honeypot-Token 头；留空 = 不鉴权
HONEYPOT_TOKEN=change-me

# 接口前缀，最终路径 /{前缀}/answer。如果 2026_10 需要按月换，改这里后 restart
HONEYPOT_API_PREFIX=2026_10_questions

# 宿主机 HTTP 端口（80 被占或不想用 80 就改成 8080 之类）
HTTP_PORT=80

# 假数据库端口（要和 docker-compose.yml 的 ports 映射对上）
DECOY_TCP_PORTS=3306:mysql,6379:redis,9200:elasticsearch,27017:mongodb
